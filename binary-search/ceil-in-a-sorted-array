class Solution {
  public:
    int findCeil(vector<int>& arr, int x) {
        // code here
        int n=arr.size();
        int start=0,end=n-1,mid;
        int ans=-1;
        
        while(start<=end){
            mid=start+(end-start)/2;
            
            if(arr[mid]<x) start=mid+1;
            else{
                ans=mid;
                end=mid-1;
            }
        }
        
        return ans;
        
    }
};
