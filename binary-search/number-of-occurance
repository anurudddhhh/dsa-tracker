class Solution {
  public:
    int countFreq(vector<int>& arr, int target) {
        // code here
        int count=0,start=0,end=arr.size()-1;
        int first=-1,last=-1,mid;
        
        while(start<=end){
            mid=start+(end-start)/2;
            if(arr[mid]==target){
                first=mid;
                end=mid-1;
            }
            
            else if(arr[mid]>target) end=mid-1;
            
            else start=mid+1;
        }
        
        start=0,end=arr.size()-1;
        
        while(start<=end){
            mid=start+(end-start)/2;
            if(arr[mid]==target){
                last=mid;
                start=mid+1;
            }
            
            else if(arr[mid]>target) end=mid-1;
            
            else start=mid+1;
        }
        
        if(last==-1 && first==-1) return 0;
        
        
        else return last-first+1;
        
        
        
    }
};
