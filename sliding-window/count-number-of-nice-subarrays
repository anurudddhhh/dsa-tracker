class Solution {
public:
    int numberOfSubarrays(vector<int>& nums, int k) {
        int ans=atmost_k(nums,k)-atmost_k(nums,k-1);
        return ans;
    }

private:
   int atmost_k(vector<int>&nums,int k){
    int low=0,high=0,odd_c=0;
    int n=nums.size();
    int count=0;
    for(high=0;high<n;high++){
        if(nums[high]%2==1) odd_c++;
        while(odd_c>k){
            if(nums[low]%2==1) odd_c--;
            low++;
        }
        count+=high-low+1;
    }

    return count;
   }
};
