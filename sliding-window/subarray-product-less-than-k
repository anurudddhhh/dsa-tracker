class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        if(k<=1) return 0;
        int low=0,high=0,prod=1,count=0;
        for(high=0;high<nums.size();high++){
            prod *= nums[high];
            while(prod>=k){
                prod /= nums[low];
                low++;
            }
            count += high-low+1;
        }

        return count;

    }
};
