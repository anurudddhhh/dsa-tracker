class Solution {
public:
    int numSubarraysWithSum(vector<int>& nums, int goal) {
        int ans=atmost_goal(nums,goal)-atmost_goal(nums,goal-1);
        return ans;
    }

private:
   int atmost_goal(vector<int>&nums,int goal){
    int low=0,high=0,count=0;
    int sum=0;
    if(goal<0) return 0;
    for(high=0;high<nums.size();high++){
        sum+=nums[high];
        while(sum>goal){
            low++;
            sum-=nums[low-1];
        }
        count +=high-low+1;
    }
    return count;
   }
};
