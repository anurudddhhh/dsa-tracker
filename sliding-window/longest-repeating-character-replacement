class Solution {
public:

    int fmax(vector<int>&a){
        int maxc=-1;
        for(int i=0;i<256;i++){
            maxc = max(maxc,a[i]);
        }
        return maxc;
    }
    int characterReplacement(string s, int k) {
        int n=s.size(),low=0,high=0,res=INT_MIN;
        vector<int>f(256);
        for(high=0;high<n;high++){
            f[s[high]]++;
            int maxc = fmax(f);
            int len=high-low+1;
            int diff = len-maxc;
            while(diff>k){
                f[s[low]]--;
                low++;
                maxc=fmax(f);
                len=high-low+1;
                diff=len-maxc;
            }

            len = high-low+1;
            res=max(res,len);
        }
        return res;
    }
};
