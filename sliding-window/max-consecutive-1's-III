class Solution {
public:
   
    int longestOnes(vector<int>& nums, int k) {
        int n=nums.size(),low=0,high=0,res=INT_MIN;
        int z_count=0;
        for(high=0;high<n;high++){
            if(nums[high]==0) z_count++;
            while(z_count>k){
                if(nums[low]==0 && z_count>0) z_count--;
                low++;   
            }
            int len=high-low+1;
            res=max(res,len);
        }
        return res;
    }
};
