class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int low=0,high=0,res=INT_MIN,count=0;
        for(int high=0;high<nums.size();high++){
            if(nums[high]==0) count++;
            while(count>0){
                if(nums[low]==0) count--;
                low++;
            }
            int len = high-low+1;
            res = max(res,len);
        }

        return res;
    }
};
