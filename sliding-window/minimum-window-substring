class Solution {
public:
    bool checker(vector<int>&have,vector<int>&need){
        for(int i=0;i<256;i++){
            if(have[i]<need[i]) return false;
        }
        return true;
    }


    string minWindow(string s, string t) {
        int low=0,high=0,res=INT_MAX,start=-1;
        vector<int>have(256,0);
        vector<int>need(256,0);
        int m=s.size();
        int n=t.size();
        if(n>m) return "";

        for(int i=0;i<n;i++){
            need[t[i]]++;
        }


        for(high=0;high<m;high++){
            have[s[high]]++;
            while(checker(have,need)){
                int len=high-low+1;
                if(res>len){
                    res=len;
                    start=low;
                }
                have[s[low]]--;
                low++;
            }
        }
        if(res==INT_MAX) return "";
        return s.substr(start,res);
    }
};
