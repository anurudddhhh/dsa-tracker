class Solution {
  public:
    int minMeetingRooms(vector<int> &start, vector<int> &end) {
        // code here
        sort(start.begin(),start.end());
        sort(end.begin(),end.end());
        int n=start.size(),m=end.size();
        int i=0,j=0,room=0,res=0;
        while(i<n && j<m){
            if(start[i]<end[j]){
                room++;
                res=max(res,room);
            }
            
            else{
                room--;
                j++;
            }
        }
        
        return res;
    }
};
