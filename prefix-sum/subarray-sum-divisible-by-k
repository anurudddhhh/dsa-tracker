class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        unordered_map<int,int>freq;
        int ans=0,sum=0;
        freq[0]++;
        for(int i=0;i<nums.size();i++){
            sum +=nums[i];
            int rem = sum % k;
            if(rem<0) rem = rem + k;
            ans += freq[rem];

            freq[rem]++;
        }
        return ans;
    }
};
