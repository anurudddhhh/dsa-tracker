class Solution {
public:
    int findMaxLength(vector<int>& nums) {
        int zero=0,one=0,ans=0;
        unordered_map<int,int>freq;
        for(int i=0;i<nums.size();i++){
            if(nums[i]==0) zero++;
            else one++;
            int diff = zero-one;
            if(diff==0){
                ans = max(ans,i+1);
            }
            if(freq.find(diff)==freq.end()){
                freq[diff]=i;
            }
            else{
                int idx = freq[diff];
                int len = i-idx;
                ans=max(ans,len);
            }
        }

        return ans;
    }
};
