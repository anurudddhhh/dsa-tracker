class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        unordered_map<int,int>freq;
        freq[0]++;
        int sum=0,res=0;
        for(int i=0;i<nums.size();i++){
            sum +=nums[i];
            int que=sum-k;
            res += freq[que];
            freq[sum]++;
        }

        return res;
    }
};
